{
  "name": "unii/sdk",
  "description": "Official PHP client library for the Unii conversational AI platform",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "unii",
    "sdk",
    "ai",
    "llm",
    "rag",
    "chat"
  ],
  "authors": [
    {
      "name": "Unii Team"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Unii\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Unii\\Tests\\": "tests/"
    }
  }
}
