{
  "name": "unii/sdk",
  "description": "Official PHP client library for the Unii conversational AI platform",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "unii",
    "sdk",
    "ai",
    "llm",
    "rag",
    "chat"
  ],
  "homepage": "https://github.com/unii-founder/unii-client",
  "support": {
    "issues": "https://github.com/unii-founder/unii-client/issues",
    "source": "https://github.com/unii-founder/unii-client"
  },
  "authors": [
    {
      "name": "Unii Team",
      "email": "dev@getunii.com"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Unii\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Unii\\Tests\\": "tests/"
    }
  }
}
