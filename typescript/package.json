{
  "name": "@unii/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for Unii API",
  "license": "MIT",
  "author": "Unii Team",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unii-founder/unii-client.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/unii-founder/unii-client#readme",
  "bugs": {
    "url": "https://github.com/unii-founder/unii-client/issues"
  },
  "keywords": [
    "unii",
    "ai",
    "sdk",
    "typescript",
    "llm",
    "rag"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  }
}
