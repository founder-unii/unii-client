{
  "name": "@unii/react",
  "version": "0.1.0",
  "description": "Official React SDK for Unii with CopilotKit-style tool execution and generative UI",
  "license": "MIT",
  "author": "Unii Team <dev@getunii.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/founder-unii/unii-client.git",
    "directory": "react"
  },
  "homepage": "https://github.com/founder-unii/unii-client#readme",
  "bugs": {
    "url": "https://github.com/founder-unii/unii-client/issues"
  },
  "keywords": [
    "unii",
    "react",
    "ai",
    "generative-ui",
    "copilotkit",
    "tools"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@unii/sdk": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  }
}
